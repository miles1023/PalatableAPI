// PalatableAPI Command Grammar
// Parser: Lark (Python) — install via: pip install lark
// This file defines the formal grammar for all plain-English commands.
// Token-to-entity binding is handled by grammar/commands.yml + framework/host/resolver.py

start: command

command: give_cmd
       | set_cmd
       | add_cmd
       | remove_cmd
       | respawn_cmd
       | teleport_cmd
       | fly_cmd
       | sort_cmd
       | revive_cmd
       | list_cmd
       | status_cmd

// ─── Commands ────────────────────────────────────────────────────────────────

give_cmd:     "give" NUMBER string "to" string
              // give 10 "Stone" to "PlayerName"

set_cmd:      "set" scope word_seq value
              // set player "PlayerName" health 100
              // set pal-species "Lamball" capture_rate 2.0
              // set global carryweight infinite

add_cmd:      "add" scope word_seq value
              // add player "PlayerName" carryweight 500

remove_cmd:   "remove" NUMBER string "from" string
              // remove 5 "Stone" from "PlayerName"

respawn_cmd:  "respawn" "player" string
              // respawn player "PlayerName"

teleport_cmd: "teleport" "player" string "to" NUMBER NUMBER NUMBER
              // teleport player "PlayerName" to 12500 -8000 200

fly_cmd:      "fly" "player" string onoff
              // fly player "PlayerName" on

sort_cmd:     "sort" "player" string "inventory"
              // sort player "PlayerName" inventory

revive_cmd:   "revive" "player" string
              // revive player "PlayerName"

list_cmd:     "list" LISTABLE
              // list players
              // list pals
              // list items

status_cmd:   "status"
              // status

// ─── Scope (who/what the command targets) ────────────────────────────────────

scope: "global"                     -> global_scope
     | "player" string              -> player_scope
     | "pal" string                 -> pal_scope
     | "pal-species" string         -> pal_species_scope
     | "item" string                -> item_scope
     | "weapon" string              -> weapon_scope
     | "armor" string               -> armor_scope
     | "food" string                -> food_scope
     | "building" string            -> building_scope

// ─── Property (what to change) ───────────────────────────────────────────────

// word_seq captures multi-word property names like "work mining" or "drop 1 chance"
word_seq: WORD+

// ─── Value (what to set it to) ───────────────────────────────────────────────

value: NUMBER           -> number_value
     | SPECIAL          -> special_value
     | onoff            -> bool_value
     | string           -> string_value

onoff: "on" | "off" | "true" | "false" | "yes" | "no"

SPECIAL: "infinite"
       | "max"
       | "min"
       | "default"
       | "free"
       | "full"
       | "empty"

LISTABLE: "players" | "pals" | "items" | "buildings" | "commands" | "hooks"

// ─── Terminals ───────────────────────────────────────────────────────────────

string: ESCAPED_STRING

%import common.NUMBER
%import common.ESCAPED_STRING
%import common.WORD
%import common.WS
%ignore WS
